# ---- LLM (set ONE provider's key) ----
LLM_PROVIDER=groq          # anthropic | openai | xai | gemini | openai_compatible
LLM_MODEL=openai/gpt-oss-120b                    # empty = default per provider (core/llm.py)`
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
OPENAI_BASE_URL=                # only for openai_compatible (e.g. http://localhost:11434/v1)

# ---- Notifications ----
NOTIFY_CHANNELS=slack           # comma list: slack,gchat,email
SLACK_WEBHOOK_URL=
GCHAT_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                  # Gmail: use an App Password
EMAIL_FROM=
EMAIL_TO=a@x.com,b@x.com

# ---- Approval links ----
APP_BASE_URL=http://localhost:8000
APPROVAL_SECRET=change-me-to-something-random   # sre-agent gen-secret

# ---- GitHub / Jira ----
GITHUB_TOKEN=
GITHUB_REPOS=owner/repo1,owner/repo2
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECTS=ABC,XYZ

# ---- Code-fix agents (git) ----
REPO_DIR=D:\Wave
WORKTREES_DIR=./data/worktrees
BASE_BRANCH=dev
BRANCH_PREFIX=ai-fix
TEST_CMD=
DRY_RUN_PUSH=true               # keep true until you trust it

# ---- Remote log watcher (SSH) ----
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=~/.ssh/id_rsa
REMOTE_LOG_PATH=/var/log/app/error.log
POLL_SECONDS=5
SSH_KNOWN_HOSTS=~/.ssh/known_hosts   # the server's host key must be listed here (ssh-keyscan -H <host> >> it)
SSH_STRICT_HOST_KEY=true             # false = accept any host key (insecure; testing only)
# REMOTE_LOG_PATH also takes {date} (the remote server's YYYY-MM-DD) and wildcards, e.g. /logs/errors-*.jsonl

# ---- Monitor agent ----
MONITOR_SOURCE=local_file       # local_file | ssh (any other value = local file path)
# Rotating logs: MONITOR_LOG_PATH may hold {date} (errors-{date}.jsonl) or a wildcard (errors-*.jsonl = newest
# file, .gz skipped) and is followed across midnight. One fixed, never-renamed file needs nothing special.
MONITOR_LOG_PATH=./data/app.log
# POLL_SECONDS above also drives `run.py monitor --mode watch`

# ---- Coding agent / Agent 3 (append-only block) ----
CODING_MAX_FIX_ITERS=2
CODING_LLM_RETRIES=2
CODING_TEST_TIMEOUT=180
CODING_MIN_CONFIDENCE=0.5
CODING_ALLOWED_PATHS=           # empty = all repo paths (minus .git/.env/...); e.g. src/,app/
VERIFY_WINDOW_SECONDS=300
MAX_AUTO_ROUNDS=2

# ---- Supervisor agent (Clef decision model via Cloudflare Workers AI) ----
SUPERVISOR_ROUTER=clef        # clef | rules (rules = offline fallback)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLEF_MODEL=@cf/cloudflare/clef
CLEF_TIMEOUT=10               # seconds per Clef request
CLEF_MIN_CONFIDENCE=0.5       # below this -> rules fallback

# ---- SRE event log (JSON lines, everything agents do) ----
SRE_LOG_PATH=./data/logs/sre.log
SRE_LOG_LEVEL=INFO            # DEBUG for quiet/audit lines too
SRE_LOG_CONSOLE=true         # true = also print log lines to stdout

# ---- Auto mode ----
SRE_AUTO_RUN=true            # true = server starts the monitor watcher; signal -> supervisor -> incident card -> (on Approve) coding, all automatic
SRE_TRACE=true               # print a line for every step (file log is always on)
MONITOR_SERVICE=wave-node     # service name for log lines that carry none

# ---- Agent switches (true/false; false = behaves like the agent folder was removed) ----
SUPERVISOR_ENABLED=true
MONITOR_ENABLED=true
INCIDENT_ENABLED=true
CODING_ENABLED=true

# Coding agent refuses fix_type=ops investigations (credentials/config/infra) unless this is true
CODING_ALLOW_OPS=false

# ---- Issue lifecycle (repeated errors become ONE issue) ----
ISSUE_QUIET_MINUTES=30        # no recurrence for this long after a fix/developer claim -> issue closes
ISSUE_SNOOZE_HOURS=24         # after Reject, repeats stay quiet this long
ISSUE_IGNORE_THRESHOLD=15     # after Ignore, a new card is sent once it repeats more than this many times
ISSUE_REMIND_HOURS=24         # reminder interval for developer-fix / fix-pending issues still failing
ISSUE_SWEEP_SECONDS=60        # how often the closer/reminder loop runs

# ---- Reviewer feedback: "Request changes" link on the approval card ----
REVISION_ENABLED=true
REVISION_MAX=3                 # plan revisions per issue before a person must decide
REVISION_NOTE_MAX_CHARS=2000
REVISION_LINK_TTL_HOURS=48     # how long a Request changes link works

# ---- Slack "Request changes" modal (optional; needs a Slack app with Interactivity) ----
# Request URL to set in the Slack app: <APP_BASE_URL>/slack/interactions
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALLOWED_USERS=

# ---- Reply-by-email for "Request changes" (optional; reads the mailbox over IMAP) ----
EMAIL_REPLY_ENABLED=false
EMAIL_REPLY_ALLOWED_SENDERS=
EMAIL_REPLY_REQUIRE_AUTH=true
EMAIL_REPLY_POLL_SECONDS=60
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ---- Ship gate: after coding finishes, a "fix ready" email; Approve commits (and pushes only when DRY_RUN_PUSH=false) ----
# A pull request is opened when GITHUB_TOKEN is set; otherwise the email gives the compare link.
SHIP_ENABLED=true

# ---- Coding verification ----
# A failing LINT_CMD or TEST_CMD sends the failure back to the fix step this many rounds in total
CODING_FIX_ROUNDS=2
# Optional lint command run in the worktree before TEST_CMD, e.g. npx eslint on the changed files
LINT_CMD=

# SHIP_MODE=auto: when coding finishes, commit, push and raise the pull request with no second approval
# (high-risk changes are still held for approval). SHIP_MODE=approve: always ask first.
SHIP_MODE=auto

# ---- Operational errors (config / credentials / rate limit / data / server / external) ----
# These get an "action needed" card (no code-fix approval). Transient kinds (rate limit, flaky upstream) are counted
# quietly and only become a card after WATCH_THRESHOLD hits inside WATCH_WINDOW_MINUTES.
WATCH_THRESHOLD=5
WATCH_WINDOW_MINUTES=10
# The monitored app's env file(s), comma separated. Lets the agent say whether a missing key is really missing,
# empty or a placeholder. Only key NAMES and set/empty status are used; values are never read out or logged.
# Empty = REPO_DIR/.env when it exists.
APP_ENV_FILES=
# Extra hostnames the agent may TCP-probe when a log names host:port (private/loopback IPs are always allowed)
RUNTIME_CHECK_HOSTS=

# ---- Scheduled jobs (alerts when a cron job did not run) ----
# JSON file listing jobs and the log line each one writes when it starts. Default: <SRE_HOME>/jobs.json
# {"jobs": [{"name": "weekly-timesheet", "service": "timesheet", "cron": "0 9 * * 1",
#            "match": "timesheet reminder job started", "grace_minutes": 15}]}
SRE_JOBS_FILE=

# ---- Health checks (things that leave no error line: crashes, full disks, expiring certs) ----
# Each check only runs when configured. HEALTH_FAILS_BEFORE_ALERT consecutive failures raise one alert per cooldown.
HEALTH_INTERVAL_SECONDS=60
HEALTH_FAILS_BEFORE_ALERT=2
HEALTH_ALERT_COOLDOWN_MINUTES=60
# URLs that must answer < 400, and host:port pairs that must accept connections
HEALTH_URLS=
HEALTH_TCP=
# Disk paths to watch (default: the agent data dir) and the minimum free percent; Linux memory floor
HEALTH_DISK_PATHS=
HEALTH_MIN_DISK_PCT=10
HEALTH_MIN_MEM_PCT=10
# TLS certificates (host or host:port) and how many days before expiry to warn
HEALTH_TLS_HOSTS=
HEALTH_TLS_WARN_DAYS=14
# systemd units that must be active; alerts on a crash loop (this many restarts between checks)
HEALTH_SYSTEMD_UNITS=
HEALTH_CRASH_RESTARTS=3
# Alert when the monitored log has produced no new line for this many minutes (0 = off)
LOG_SILENCE_MINUTES=0
# Dead-man switch: pinged every pass; an external service (healthchecks.io style) alerts if the agent dies
HEALTH_HEARTBEAT_URL=

# ---- Volume anomalies ----
SPIKE_WINDOW_MINUTES=5
SPIKE_BASELINE_MINUTES=60
SPIKE_FACTOR=5
SPIKE_MIN_ERRORS=20
NEW_ISSUE_WINDOW_MINUTES=10
NEW_ISSUE_BURST=3
ANOMALY_COOLDOWN_MINUTES=30

# ---- Severity, quiet hours, paging, escalation ----
# Services / regexes (comma separated) that are business-critical: CRITICAL severity, and they page
CRITICAL_SERVICES=
CRITICAL_PATTERNS=
# Local time range; signals below QUIET_MIN_SEVERITY are stored and counted but their card waits until it ends
QUIET_HOURS=
QUIET_MIN_SEVERITY=HIGH
# Generic JSON webhook for CRITICAL signals and health alerts marked urgent (on-call tool, SMS gateway, loud channel)
PAGE_WEBHOOK_URL=
# Cards nobody answered: re-sent every ISSUE_UNANSWERED_HOURS; after ESCALATE_AFTER_HOURS also sent here (0 = never)
ISSUE_UNANSWERED_HOURS=4
ESCALATE_AFTER_HOURS=0
ESCALATION_SLACK_WEBHOOK_URL=
ESCALATION_EMAIL_TO=

# ---- Hand-off retries (a stored error that no agent investigated) ----
HANDOFF_MAX_ATTEMPTS=3
HANDOFF_RETRY_MINUTES=5

# ---- Several log sources: MONITOR_LOG_PATH accepts a comma separated list, one watcher each ----
# /var/log/app/error.log, docker:web, journald:myapp.service, ssh

# ---- Coding agent: safety and follow-through ----
# A failed or blocked coding run sends a "fix failed" card; Retry runs it again on a fresh branch, up to this many times
CODING_MAX_RETRIES=2
# Keep the work area of a failed run for inspection (default: removed; the diff it tried is saved on the record)
CODING_KEEP_FAILED=false
# Refuse to produce a fix at all when TEST_CMD is empty (default: allowed, but the change is held for approval)
CODING_REQUIRE_TESTS=false
# Lint/test commands run with a scrubbed environment (no API keys, tokens, DB URLs). Extra names to pass through:
CODING_TEST_ENV_ALLOW=
# Linux only: run the checks with no network (needs `unshare`); other systems log a warning and run normally
CODING_TEST_NO_NETWORK=false
# Ask the model to add a regression test (kept only if the suite still passes) and to review its own diff
CODING_WRITE_TESTS=true
CODING_SELF_REVIEW=true
# Work areas not touched for this many days are removed (ones waiting for a decision are kept)
CODING_WORKTREE_TTL_DAYS=7
# After a fix pull request is opened: poll GitHub (needs GITHUB_TOKEN), nag when nobody reviewed it, and treat errors
# in the first VERIFY_DEPLOY_GRACE_MINUTES after the merge as the old version still running
PR_POLL_SECONDS=300
PR_REMIND_HOURS=24
VERIFY_DEPLOY_GRACE_MINUTES=15

# ---- Approval links ----
# Links expire (hours) and are bound to one button; opening one only shows a Confirm page. A card nobody answers is
# re-sent with fresh links (ISSUE_UNANSWERED_HOURS).
APPROVAL_LINK_HOURS=168
# Links sent before this release used the old token. true = still accept them (use briefly while upgrading)
APPROVAL_ACCEPT_LEGACY=false

# ---- Investigation queue and budget ----
# The log watcher only queues signals; this many workers do the model work (most severe first)
HANDOFF_WORKERS=2
HANDOFF_QUEUE_MAX=500
HANDOFF_BACKLOG_ALERT=50
# At most this many investigations per hour / day (0 = no limit). CRITICAL signals may use 3x. Signals over the limit
# wait and are investigated when the window frees up; one alert says so.
INVESTIGATIONS_PER_HOUR=30
INVESTIGATIONS_PER_DAY=300
# Signals stored but never investigated (restart, crash, full queue, paused budget) are found again this often
RECONCILE_SECONDS=300
RECONCILE_MIN_AGE_MINUTES=2
RECONCILE_LOOKBACK_HOURS=24

# ---- Retention (days; 0 = keep forever). Waiting signals, open issues and approval records are never removed ----
RETENTION_DAYS_SIGNALS=30
RETENTION_DAYS_RESULTS=60
RETENTION_DAYS_ISSUES=180

# ---- Timezones (IANA names such as UTC or Asia/Kolkata; empty = the server's own local time) ----
# The zone a cron schedule in jobs.json is written in (a job can also set "timezone")
JOBS_TIMEZONE=
# The zone the app stamps log lines in when they carry no offset (a job can also set "log_timezone")
LOG_TIMEZONE=
QUIET_TIMEZONE=

# ---- Coding agent: files it must leave to a person ----
# Credentials (.env.production, id_rsa, *.pem, secrets/...) are never read or edited. CI and deploy files
# (.github/, Dockerfile, *.tf, Makefile ...) are refused for edits unless this is true.
CODING_ALLOW_INFRA_PATHS=false

# ---- Model call ----
# Nothing is sent as the temperature unless this is set (newer models reject a custom value with HTTP 400)
LLM_TEMPERATURE=
# One tiny model call at start-up; a wrong key/model/parameter is reported once, loudly, with the provider's reason
LLM_SELFTEST_ON_START=true

# ---- Grouping ----
# true = only ids and numbers are ignored when grouping errors (file names, paths, quoted names then stay distinct)
FINGERPRINT_STRICT=false

# ---- Severity rules ----
# Built-in rules: inbound 4xx and bot-probe paths and expected CORS rejections = LOW; rate limits, external services,
# bad data and security probes = MEDIUM; everything else keeps the log level's HIGH. false = switch them off.
SEVERITY_DEFAULTS=true
# Your own rules: {"rules": [{"match": "regex", "service": "optional", "severity": "LOW|MEDIUM|HIGH|CRITICAL"}]}
# Default file: <SRE_HOME>/severity.json
SEVERITY_RULES_FILE=
# A service's own default, e.g. bot-probe=LOW,internal-tool=MEDIUM
SERVICE_SEVERITY=
# LOW issues are counted quietly and listed in a digest every LOW_DIGEST_HOURS (0 = no digest);
# one seen this many times becomes a normal card (0 = never)
LOW_DIGEST_HOURS=24
LOW_ESCALATE_COUNT=200

# ---- Ignore list ----
# Lines matching these regexes are counted but never become an incident. One per line or separated by ;;
# The "Ignore similar" button on a card adds to the ignore file (default <SRE_HOME>/ignore.json)
IGNORE_PATTERNS=
IGNORE_FILE=

# ---- Log sources ----
# MONITOR_LOG_PATH takes several sources, each with the service it belongs to after an @:
#   /var/log/qa/error.log@qa-api, /var/log/prod/error.log@prod-api, docker:web@storefront, journald:app.service@billing
# A log watched for the first time in watch mode is read from its END (new errors only). true = replay its history,
# marked "(backlog)" on the cards.
MONITOR_REPLAY_BACKLOG=false
# Idle polls are DEBUG and not printed; true prints DEBUG lines to the console as well
SRE_TRACE_DEBUG=false
