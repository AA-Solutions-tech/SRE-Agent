# SRE Agent configuration (installed package).
# Linux: /etc/sre-agent/sre-agent.env   (root:sre-agent, mode 0640; kept on upgrade)
# Easiest:        sudo sre-agent setup   (asks questions, writes this file, checks it, starts the service)
# After editing by hand:  sudo sre-agent doctor  &&  sudo systemctl restart sre-agent
#
# Install paths are set by the service unit and normally need no change here:
#   SRE_HOME=/var/lib/sre-agent   SRE_LOG_PATH=/var/log/sre-agent/sre.log

# ---- Server / security (generated on first install; keep them secret) ----
SRE_API_KEY=__GENERATED__          # clients send header  X-API-Key: <value>  to /run, /signals, /issues
APPROVAL_SECRET=__GENERATED__      # signs Approve/Reject links
SRE_BIND=127.0.0.1                 # put nginx/Caddy in front for HTTPS; 0.0.0.0 only if you must
SRE_PORT=8000
APP_BASE_URL=http://localhost:8000 # public HTTPS URL people click in Slack/email, e.g. https://sre.example.com

# ---- LLM (set ONE provider's key) ----
LLM_PROVIDER=anthropic             # anthropic | openai | xai | groq | openai_compatible
LLM_MODEL=                         # empty = provider default
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
OPENAI_BASE_URL=                   # only for openai_compatible (e.g. http://localhost:11434/v1)

# ---- Notifications ----
NOTIFY_CHANNELS=slack              # comma list: slack,gchat,email
SLACK_WEBHOOK_URL=
GCHAT_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ---- Log source ----
MONITOR_SOURCE=ssh                 # ssh | local_file
MONITOR_SERVICE=my-service         # service name for log lines that carry none
MONITOR_LOG_PATH=                  # local_file only: path, {date} or wildcard (errors-*.jsonl)
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=/var/lib/sre-agent/.ssh/id_ed25519
SSH_KNOWN_HOSTS=/var/lib/sre-agent/.ssh/known_hosts
SSH_STRICT_HOST_KEY=true
REMOTE_LOG_PATH=/var/log/app/error.log   # also {date} and wildcards
POLL_SECONDS=5

# ---- Repository the fixes go to ----
REPO_DIR=                          # empty = /var/lib/sre-agent/repo (git clone your repo there)
BASE_BRANCH=main
BRANCH_PREFIX=ai-fix
TEST_CMD=                          # e.g. npm test -- --ci ; the tool must be on the service PATH
LINT_CMD=
GITHUB_TOKEN=                      # opens pull requests when set
GITHUB_REPOS=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECTS=

# ---- Supervisor routing ----
SUPERVISOR_ROUTER=rules            # rules (offline) | clef (needs Cloudflare Workers AI below)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---- Safety switches (safe first-install defaults; loosen once you trust it) ----
SRE_AUTO_RUN=false                 # true = watch logs and run the loop automatically
CODING_ENABLED=false               # true = the coding agent may write fixes
DRY_RUN_PUSH=true                  # false = approved fixes are pushed
SHIP_MODE=approve                  # approve = always ask before commit/push/PR ; auto = no second approval
CODING_ALLOW_OPS=false
SUPERVISOR_ENABLED=true
MONITOR_ENABLED=true
INCIDENT_ENABLED=true
SHIP_ENABLED=true

# ---- Logging ----
SRE_LOG_LEVEL=INFO
SRE_LOG_CONSOLE=false              # true = also to journald
SRE_TRACE=true
